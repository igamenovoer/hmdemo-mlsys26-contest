{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead-code-synth-research.email.research-summary",
  "title": "research-summary",
  "type": "object",
  "required": ["schema_id", "schema_version", "kind", "run_id", "plan_revision", "payload_id", "sender_id", "receiver_id", "payload"],
  "properties": {
    "schema_id": { "const": "lead-code-synth-research.email.research-summary" },
    "schema_version": { "const": "1" },
    "kind": { "const": "result" },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_revision": { "type": "string", "minLength": 1 },
    "payload_id": { "type": "string", "minLength": 1 },
    "sender_id": { "const": "researcher" },
    "receiver_id": { "enum": ["planner", "cuda-coder-1", "cuda-coder-2", "synthesizer"] },
    "route_id": { "const": "researcher-to-requester" },
    "payload": {
      "type": "object",
      "required": ["request_id", "source_scope_used", "summary", "source_attribution", "reusable_patterns", "risk_notes"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "source_scope_used": { "enum": ["local-and-network", "local-only", "network-only"] },
        "summary": { "type": "string", "minLength": 1 },
        "source_attribution": { "type": "array", "items": { "type": "string" } },
        "local_refs": { "type": "array", "items": { "type": "string" } },
        "network_refs": { "type": "array", "items": { "type": "string" } },
        "reusable_patterns": { "type": "array", "items": { "type": "string" } },
        "speculative_ideas": { "type": "array", "items": { "type": "string" } },
        "applicability_notes": { "type": "string" },
        "risk_notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

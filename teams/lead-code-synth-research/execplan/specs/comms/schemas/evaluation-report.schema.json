{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead-code-synth-research.email.evaluation-report",
  "title": "evaluation-report",
  "type": "object",
  "required": ["schema_id", "schema_version", "kind", "run_id", "plan_revision", "payload_id", "sender_id", "receiver_id", "payload"],
  "properties": {
    "schema_id": { "const": "lead-code-synth-research.email.evaluation-report" },
    "schema_version": { "const": "1" },
    "kind": { "const": "result" },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_revision": { "type": "string", "minLength": 1 },
    "payload_id": { "type": "string", "minLength": 1 },
    "sender_id": { "const": "evaluator" },
    "receiver_id": { "const": "planner" },
    "route_id": { "const": "evaluator-to-planner" },
    "payload": {
      "type": "object",
      "required": ["evaluation_id", "candidate_id", "project_cli_variant_ref", "decision", "correctness_status", "anti_hacking_review", "recommended_planner_followup"],
      "properties": {
        "evaluation_id": { "type": "string", "minLength": 1 },
        "candidate_id": { "type": "string", "minLength": 1 },
        "project_cli_variant_ref": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["accepted", "rejected"] },
        "official_timing_provenance": { "type": "string" },
        "correctness_status": { "type": "string", "minLength": 1 },
        "speedup_or_latency_summary": { "type": "string" },
        "anti_hacking_review": { "type": "string", "minLength": 1 },
        "rejection_reason": { "type": "string" },
        "recommended_planner_followup": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

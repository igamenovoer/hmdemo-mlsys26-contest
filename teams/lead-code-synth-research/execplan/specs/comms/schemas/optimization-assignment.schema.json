{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead-code-synth-research.email.optimization-assignment",
  "title": "optimization-assignment",
  "type": "object",
  "required": ["schema_id", "schema_version", "kind", "run_id", "plan_revision", "payload_id", "sender_id", "receiver_id", "payload"],
  "properties": {
    "schema_id": { "const": "lead-code-synth-research.email.optimization-assignment" },
    "schema_version": { "const": "1" },
    "kind": { "const": "request" },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_revision": { "type": "string", "minLength": 1 },
    "payload_id": { "type": "string", "minLength": 1 },
    "sender_id": { "const": "planner" },
    "receiver_id": { "enum": ["cuda-coder-1", "cuda-coder-2"] },
    "route_id": { "enum": ["planner-to-coder-1", "planner-to-coder-2"] },
    "payload": {
      "type": "object",
      "required": ["cycle_id", "assignment_id", "coder_slot", "direction", "current_best_ref", "allowed_edit_surface", "evidence_expectations", "risk_notes"],
      "properties": {
        "cycle_id": { "type": "string", "minLength": 1 },
        "assignment_id": { "type": "string", "minLength": 1 },
        "coder_slot": { "enum": ["cuda-coder-1", "cuda-coder-2"] },
        "direction": { "type": "string", "minLength": 1 },
        "current_best_ref": { "type": "string", "minLength": 1 },
        "allowed_edit_surface": { "type": "array", "items": { "type": "string" } },
        "failed_direction_summary": { "type": "string" },
        "evidence_expectations": { "type": "array", "items": { "type": "string" } },
        "risk_notes": { "type": "array", "items": { "type": "string" } },
        "selected_research_refs": { "type": "array", "items": { "type": "string" } },
        "selected_profile_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead-code-synth-research.email.gpu-wait-report",
  "title": "gpu-wait-report",
  "type": "object",
  "required": ["schema_id", "schema_version", "kind", "run_id", "plan_revision", "payload_id", "sender_id", "receiver_id", "payload"],
  "properties": {
    "schema_id": { "const": "lead-code-synth-research.email.gpu-wait-report" },
    "schema_version": { "const": "1" },
    "kind": { "const": "blocked" },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_revision": { "type": "string", "minLength": 1 },
    "payload_id": { "type": "string", "minLength": 1 },
    "sender_id": { "type": "string", "minLength": 1 },
    "receiver_id": { "const": "planner" },
    "route_id": { "const": "coder-blocker-to-planner" },
    "payload": {
      "type": "object",
      "required": ["cycle_id", "assignment_id", "agent_id", "attempted_gpu_selection_evidence", "blocked_action", "next_wakeup_need"],
      "properties": {
        "cycle_id": { "type": "string", "minLength": 1 },
        "assignment_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "attempted_gpu_selection_evidence": { "type": "string", "minLength": 1 },
        "blocked_action": { "type": "string", "minLength": 1 },
        "next_wakeup_need": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
